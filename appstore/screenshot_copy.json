{
  "order": [
    "week",
    "reader",
    "topics",
    "picker",
    "search",
    "settings",
    "stats"
  ],
  "slides": {
    "week": {
      "light": {
        "eyebrow": "לימוד השבוע",
        "headline": [
          "הלכה אחת ביום.",
          "{בדיוק לפי הסדר.}"
        ],
        "sub": "פרשת השבוע וההלכות של החג,\nמוכנות לך בכל יום"
      }
    },
    "reader": {
      "light": {
        "eyebrow": "קוראים בנחת",
        "headline": [
          "הבן איש חי",
          "{בעברית פשוטה.}"
        ],
        "sub": "מקור וביאור ברור,\nעם קישור ישיר לספריא"
      },
      "dark": {
        "eyebrow": "מצב כהה",
        "headline": [
          "גם בלילה,",
          "{נעים לעיניים.}"
        ],
        "sub": "עיצוב כהה מלא,\nבלי סינוור ובלי מאמץ"
      }
    },
    "topics": {
      "light": {
        "eyebrow": "לפי נושא",
        "headline": [
          "כל נושא",
          "{במרחק נגיעה.}"
        ],
        "sub": "תפילה, ברכות, שבת,\nכשרות ועוד"
      }
    },
    "picker": {
      "light": {
        "eyebrow": "כל הפרשיות",
        "headline": [
          "כל פרשה,",
          "{כל השנה.}"
        ],
        "sub": "שנה ראשונה ושנייה, עם סימון\nשל מה שכבר למדתם"
      }
    },
    "search": {
      "light": {
        "eyebrow": "חיפוש בכל הספר",
        "headline": [
          "מוצאים הלכה",
          "{בכמה שניות.}"
        ],
        "sub": "מילה, נושא או ביטוי,\nוהתוצאות כבר כאן"
      }
    },
    "settings": {
      "light": {
        "eyebrow": "הגדרות",
        "headline": [
          "מותאם",
          "{בדיוק לך.}"
        ],
        "sub": "ערכת נושא, גודל אותיות\nושיתוף בלחיצה"
      }
    },
    "stats": {
      "light": {
        "eyebrow": "התקדמות",
        "headline": [
          "רואים כמה",
          "{כבר למדתם.}"
        ],
        "sub": "רצף לימוד, התקדמות\nותזכורת יומית"
      }
    }
  }
}